---
import { MIN_SIDE_URL } from "astro:env/server";
import { BodyLong, Heading } from "@navikt/ds-react";
import Layout from "@src/layouts/Layout.astro";
import KattIBoks from "@src/shared/assets/KattIBoks";
import type { Language } from "@src/shared/language/language";
import { text } from "@src/shared/language/text";
import styles from "./_error.module.css";

const language = Astro.currentLocale as Language;
---

<Layout title="Utkast">
  <div class={styles.container}>
    <Heading size={'xlarge'}>{text.errorHeading[language]}</Heading>
    <KattIBoks alt={text.errorKitten[language]} />
    <BodyLong>
      <strong>{text.errorText[language]}</strong>
    </BodyLong>
    <BodyLong>
      {text.errorHelp[language]}
      <a href={MIN_SIDE_URL}>{text.minSide[language]}</a>
    </BodyLong>
  </div>
</Layout>
