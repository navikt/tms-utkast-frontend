---
import type { Language } from "@src/shared/language/language";
import ErrorBox from "./fallback/Error.astro";
import IngenUtkast from "./ingen/IngenUtkast.astro";
import UtkastLinkCard from "./link-card/UtkastLinkCard";
import UtkastLinkCardMasked from "./link-card/UtkastLinkCardMasked";
import styles from "./Utkast.module.css";
import type { UtkastElement } from "./utkastTypes";
import { isIngen, isVisible, sortByOpprettet } from "./utkastUtils";

interface Props {
  language: Language;
  utkast: UtkastElement[];
  isError: boolean;
}

const { language, utkast, isError } = Astro.props;

const maskedUtkast = utkast.filter((utkast) => utkast.masked);
const visibleUtkast = utkast
    .filter(isVisible)
    .sort(sortByOpprettet);
---

<>
  {
    () => {
      if (isError) {
        return <ErrorBox language={language} />;
      }
      if (isIngen(utkast)) {
        return <IngenUtkast language={language} />;
      }
      return (
        <ul class={styles.utkastList}>
          {visibleUtkast.map((utkast: UtkastElement) =>
            <li class={styles.container}>
              <UtkastLinkCard client:load utkast={utkast} language={language} />
            </li>
          )}
          {maskedUtkast.map(() => (
            <li class={styles.container}>
              <UtkastLinkCardMasked client:load language={language} />
            </li>
          ))}
        </ul>
      );
    }
  }
</>
